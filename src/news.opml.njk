---
permalink: /news{{pageState}}.opml.xml
eleventyExcludeFromCollections: true
pagination:
  data: pageStates
  size: 1
  alias: pageState
  generatePageOnEmptyData: true
pageStates:
  -
  - NoSubstack
---
<?xml version="1.0" encoding="UTF-8"?>
<opml version="1.0">

  <head>
    <title>News feeds for Shavon Nand's blogroll</title>
    <dateCreated>{{ page.date | dateToRfc822 }}</dateCreated>
  </head>

  <body>
    <outline text="News" title="News">
      {% for site in newsBlogroll|sortBlogs %}
        {% if pageState != 'NoSubstack' or 'Substack' not in (site.tags or []) %}
      <outline text="{{ site.text if site.text else site.author }}" title="{{ site.text if site.text else site.author }}"
        type="rss" xmlUrl="{{ site.xmlUrl }}" htmlUrl="{{ site.htmlUrl }}" />
        {% endif %}
      {% endfor %}
    </outline>
  </body>
</opml>