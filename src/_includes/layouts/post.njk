{% extends "layouts/with-nav.njk" %}
{% block content %}
<article class="post">

  {% if image %}
  {% set heroFigure %}
  <figure class="post-hero{% if heroStyle == 'full' %} post-hero-full{% endif %}">
    <img src="/{{ image }}" width="1456" height="819" alt="{{ alt }}" loading="lazy">
    {% if caption %}
    <figcaption>{{ caption }}</figcaption>
    {% endif %}
  </figure>
  {% endset %}
  {% endif %}

  {% if heroPosition == 'above' %}{{ heroFigure | safe }}{% endif %}

  <header class="post-header">
    {% if section %}
    <a class="post-section" href="/blog/{{ section | slugify }}/">{{ section }}</a>
    {% endif %}
    <h1 class="post-title">{{ title }}</h1>
    {% if subtitle %}
    <p class="post-subtitle">{{ subtitle }}</p>
    {% endif %}
    <div class="post-meta">
      <a href="/" class="post-author">Shavon Nand</a>
      {% if date %}
      <time class="post-date" datetime="{{ date.toISOString() }}">{{ date | readableDate }}</time>
      {% endif %}
      {% if showReadingTime %}
      <span class="reading-time">{{ content | readingTime }}</span>
      {% endif %}
    </div>

    {% if heroPosition != 'above' %}{{ heroFigure | safe }}{% endif %}
  </header>

  <div class="available-content">
  <div class="article-content">
  {{ content | safe }}
  </div>
  </div>
</article>
{% endblock %}

{% block js %}
{{ super() }}
<script src="/assets/js/lightbox.js"></script>
{% endblock %}
